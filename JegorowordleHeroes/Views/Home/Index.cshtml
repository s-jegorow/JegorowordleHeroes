@{
    Layout = "_Layout";
    var userName = User.Identity?.IsAuthenticated == true ? User.Identity.Name : null;
}
<section class="top">
    <div class="mode-switch" role="group" aria-label="Spielart">
        <button id="mode-friend" type="button" class="active" aria-pressed="true">Mit Freund</button>
        <button id="mode-random" type="button" aria-pressed="false">Zufallsgegner</button>
        <button id="mode-solo" type="button" aria-pressed="false">Solo</button>
    </div>
    <div class="names">
        <input id="me" maxlength="12" placeholder="Dein Name" aria-label="Dein Name" value="@userName" readonly="@(userName != null)" />
        <input id="room" maxlength="8" placeholder="Session-Code" aria-label="Session-Code" />
        <button id="join">Beitreten</button>
        <button id="search" type="button" hidden>Gegner suchen</button>
        <button id="solo" type="button" hidden>Starten</button>
    </div>
</section>

<section id="search-info" class="search-info" hidden>
    <span>Suche Gegner … <span id="search-time">0:00</span></span>
    <button id="search-cancel" type="button">Abbrechen</button>
</section>

<section id="duel" class="duel" aria-label="Duell" hidden>
    <div id="duel-p1" class="duel-player empty">
        <img id="p1-avatar" class="duel-avatar" src="~/img/avatars/avatarguest.jpg" alt="" />
        <strong id="p1">wartet …</strong>
        <span id="p1-info" class="duel-info"></span>
    </div>
    <div class="duel-vs">VS</div>
    <div id="duel-p2" class="duel-player empty">
        <img id="p2-avatar" class="duel-avatar" src="~/img/avatars/avatarguest.jpg" alt="" />
        <strong id="p2">wartet …</strong>
        <span id="p2-info" class="duel-info"></span>
    </div>
</section>

<div class="board-wrap">
    <section id="board" class="board" aria-label="Wordle-Felder"></section>
    <div id="toast" class="toast" role="status" hidden></div>
    <div id="overlay" class="overlay" hidden>
        <div id="overlay-title" class="overlay-title"></div>
        <div id="overlay-sub" class="overlay-sub"></div>
        <div id="overlay-extra"></div>
        <div class="overlay-actions">
            <button id="rematch" type="button" hidden>Revanche</button>
            <button id="new-opponent" type="button" hidden>Neuer Gegner</button>
        </div>
    </div>
</div>

<section class="keyboard" id="keyboard"></section>

@section HeaderLeft {
    <button id="chat-open" class="header-button" type="button" aria-controls="chat-panel" aria-expanded="false" aria-label="Chat" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
        </svg>
        <span id="chat-badge" class="chat-badge" hidden>0</span>
    </button>
    <div id="chat-preview" class="chat-preview" aria-hidden="true"></div>
}

<aside id="chat-panel" class="chat-panel" aria-label="Chat">
    <div class="chat-header">
        <span>Chat</span>
        <button id="chat-close" type="button" aria-label="Chat schließen">✕</button>
    </div>
    <div id="chat-messages" class="chat-messages" aria-live="polite"></div>
    <form id="chat-form" class="chat-form" autocomplete="off">
        <input id="chat-input" maxlength="200" placeholder="Nachricht …" />
        <button type="submit">Senden</button>
    </form>
</aside>

<div id="room-info" class="room-info" hidden>
    <strong id="room-label"></strong>
    <div class="room-actions">
        <button id="copy-link" type="button">Link kopieren</button>
        <button id="leave-room" type="button">Verlassen</button>
    </div>
</div>


@section Scripts {
    <script src="~/js/game.js" asp-append-version="true"></script> @* cache busting gegen veralteten cache beim laden *@
}
