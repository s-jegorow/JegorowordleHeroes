@page
@model LoginModel
@{
    ViewData["Title"] = "Einloggen";
}

<section class="auth">
    <h1>@ViewData["Title"]</h1>
    <form id="account" method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="auth-error" role="alert"></div>
        <div class="auth-field">
            <label asp-for="Input.UserName">Benutzername</label>
            <input asp-for="Input.UserName" autocomplete="username" aria-required="true" />
            <span asp-validation-for="Input.UserName" class="auth-error"></span>
        </div>
        <div class="auth-field">
            <label asp-for="Input.Password">Passwort</label>
            <input asp-for="Input.Password" autocomplete="current-password" aria-required="true" />
            <span asp-validation-for="Input.Password" class="auth-error"></span>
        </div>
        <label class="auth-check">
            <input asp-for="Input.RememberMe" />
            @Html.DisplayNameFor(m => m.Input.RememberMe)
        </label>
        <button id="login-submit" type="submit" class="auth-submit">Einloggen</button>
    </form>
    <p class="auth-links">
        Noch kein Konto? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Registrieren</a>
    </p>
    <p class="auth-links">
        <a href="~/">Zurück zum Spiel</a>
    </p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
